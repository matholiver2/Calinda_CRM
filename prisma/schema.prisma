// CALINDA — schema do banco de dados
// Multi-tenant: cada Empresa tem seus próprios usuários, etapas de funil,
// agentes de IA, leads e configurações. Um usuário super_admin não pertence
// a nenhuma empresa (empresaId nulo) e enxerga a plataforma inteira.
// Banco: PostgreSQL (Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  super_admin
  admin
  gestor
  vendedor
}

enum PapelEmpresa {
  admin
  gestor
  vendedor
}

enum TipoEtapa {
  funil
  remarketing
  cliente
  finalizado
}

enum StatusLead {
  ativo
  cliente
  perdido
  remarketing
  finalizado
}

enum RemetenteMensagem {
  lead
  ia
  vendedor
}

enum StatusEntrega {
  enviado
  entregue
  lido
  falhou
}

enum StatusReuniao {
  agendada
  confirmada
  realizada
  no_show
  cancelada
}

enum ModalidadeReuniao {
  google_meet
  whatsapp
  presencial
}

enum ResultadoReuniao {
  fechou
  nao_fechou
  pendente
}

enum StatusConvite {
  pendente
  aceito
  expirado
  revogado
}

enum StatusWhatsappSessao {
  desconectado
  conectando
  conectado
}

enum StatusFollowUpAgendado {
  pendente
  enviado
  cancelado
  falhou
}

enum PeriodicidadePlano {
  mensal
  anual
  unico
}

enum StatusOrcamento {
  rascunho
  enviado
}

enum StatusVenda {
  rascunho
  confirmada
}

enum FormaPagamento {
  pix
  cartao
  boleto
  dinheiro
  transferencia
}

model Empresa {
  id       String   @id @default(uuid())
  nome     String
  ativo    Boolean  @default(true)
  logoUrl  String?  @db.Text @map("logo_url")
  criadoEm DateTime @default(now()) @map("criado_em")

  membros       MembroEmpresa[]
  assistenteMensagens AssistenteMensagem[]
  usuarios      Usuario[] // DEPRECATED — ver comentário em Usuario.empresaId
  etapas        EtapaFunil[]
  leads         Lead[]
  agentesIa     AgenteIa[]
  configuracoes  Configuracao[]
  convites       Convite[]
  whatsappSessao WhatsappSessao?
  planos         Plano[]
  orcamentos     Orcamento[]
  vendas         Venda[]
  notificacoes   Notificacao[]
  pastasArquivo  PastaArquivo[]
  arquivos       Arquivo[]
  gruposCliente  GrupoCliente[]
  followUpsAgendados FollowUpAgendado[]

  @@map("empresas")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String?  @map("senha_hash")
  googleId  String?  @unique @map("google_id")
  // DEPRECATED — dado já migrado pra MembroEmpresa (ver
  // scripts/migrar-multi-empresa.ts). Nenhum código novo lê esses dois
  // campos; ficam por enquanto só pra não dropar colunas em produção antes
  // de todo o resto do app estar migrado e confirmado funcionando. Remover
  // num cleanup separado, depois de validar em produção.
  papel      Papel    @default(vendedor)
  empresaId  String?  @map("empresa_id")
  empresa    Empresa? @relation(fields: [empresaId], references: [id])
  superAdmin Boolean @default(false) @map("super_admin")
  ativo     Boolean  @default(true)
  avatarCor String   @default("#DC2626") @map("avatar_cor")
  avatarUrl String?  @db.Text @map("avatar_url")
  onboardingPessoalConcluido Boolean @default(false) @map("onboarding_pessoal_concluido")
  // Data/hora em que a pessoa viu pela última vez a tela de novidades (ver
  // src/lib/changelog.ts) — null significa "nunca viu". Comparado contra a
  // data da entrada mais recente do changelog pra decidir se mostra o popup
  // automático ao entrar.
  changelogVistoEm DateTime? @map("changelog_visto_em")
  criadoEm  DateTime @default(now()) @map("criado_em")

  membrosEmpresa MembroEmpresa[]
  assistenteMensagens AssistenteMensagem[]

  // Google Calendar (por usuário — cada vendedor conecta o próprio Gmail)
  googleCalendarAccessToken  String?   @map("google_calendar_access_token")
  googleCalendarRefreshToken String?   @map("google_calendar_refresh_token")
  googleCalendarTokenExpiry  DateTime? @map("google_calendar_token_expiry")
  googleCalendarEmail        String?   @map("google_calendar_email")
  googleCalendarSyncToken    String?   @map("google_calendar_sync_token")

  leads             Lead[]           @relation("VendedorLeads")
  reunioes          Reuniao[]        @relation("VendedorReunioes")
  mensagens         Mensagem[]
  historicoEdits    HistoricoEtapa[] @relation("VendedorHistorico")
  convitesEnviados  Convite[]        @relation("ConvidadoPor")
  orcamentosCriados Orcamento[]
  vendas            Venda[]
  followUpsAgendadosCriados FollowUpAgendado[]

  @@map("usuarios")
}

// Vínculo de uma conta (Usuario, identidade global) com uma empresa — uma
// mesma conta pode ter um MembroEmpresa em várias empresas, cada um com seu
// próprio papel. Substitui Usuario.empresaId/papel (deprecados acima).
model MembroEmpresa {
  id        String       @id @default(uuid())
  usuarioId String       @map("usuario_id")
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId String       @map("empresa_id")
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  papel     PapelEmpresa
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now()) @map("criado_em")

  @@unique([usuarioId, empresaId])
  @@map("membros_empresa")
}

model Convite {
  id             String        @id @default(uuid())
  email          String
  papel          Papel
  empresaId      String?       @map("empresa_id")
  empresa        Empresa?      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  token          String        @unique
  status         StatusConvite @default(pendente)
  convidadoPorId String?       @map("convidado_por_id")
  convidadoPor   Usuario?      @relation("ConvidadoPor", fields: [convidadoPorId], references: [id])
  criadoEm       DateTime      @default(now()) @map("criado_em")
  expiraEm       DateTime      @map("expira_em")

  @@map("convites")
}

model EtapaFunil {
  id                String    @id @default(uuid())
  empresaId         String    @map("empresa_id")
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome              String
  ordem             Int
  cor               String    @default("#6B7280")
  tipo              TipoEtapa @default(funil)
  promptIa          String?   @map("prompt_ia")
  descricaoObjetivo String?   @map("descricao_objetivo")
  handoffHumano     Boolean   @default(false) @map("handoff_humano")

  leads     Lead[]
  historico HistoricoEtapa[]
  agentesIa AgenteIa[]

  @@map("etapas_funil")
}

model Lead {
  id           String     @id @default(uuid())
  empresaId    String     @map("empresa_id")
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome         String
  telefone     String
  email        String?
  origem       String     @default("Não informado")
  etapaAtualId String     @map("etapa_atual_id")
  etapaAtual   EtapaFunil @relation(fields: [etapaAtualId], references: [id])
  vendedorId   String?    @map("vendedor_id")
  vendedor     Usuario?   @relation("VendedorLeads", fields: [vendedorId], references: [id])
  status       StatusLead @default(ativo)
  iaAtiva      Boolean    @default(true) @map("ia_ativa")
  // Marcado quando um vendedor manda uma mensagem manual enquanto a IA
  // estava ativa (ver POST /api/leads/[id]/mensagens) — a IA já fica
  // pausada via iaAtiva=false nesse momento, esse campo é só pra exibir
  // "assumido manualmente às HH:mm" na tela da conversa. Reativar a IA
  // (iaAtiva=true de novo) limpa esse campo.
  humanTakeoverEm DateTime? @map("human_takeover_em")
  instagramSite String?    @map("instagram_site")
  observacoes  String?    @db.Text
  grupoId      String?    @map("grupo_id")
  grupo        GrupoCliente? @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  entrouEm     DateTime   @default(now()) @map("entrou_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  // Resposta da IA agendada (delay "parece humano" antes de responder) —
  // persistido no banco porque um setTimeout em memória não sobrevive entre
  // invocações de função serverless (Vercel). Um poller externo processa
  // isso quando chega a hora (ver pollRespostasIaAgendadas em
  // conversationService.ts). respostaIaMensagemGatilhoId identifica qual
  // mensagem do lead motivou o agendamento, pra não responder de novo se
  // outra mensagem mais recente já assumiu o agendamento.
  respostaIaAgendadaPara      DateTime? @map("resposta_ia_agendada_para")
  respostaIaMensagemGatilhoId String?   @map("resposta_ia_mensagem_gatilho_id")

  mensagens     Mensagem[]
  historico     HistoricoEtapa[]
  reunioes      Reuniao[]
  orcamentos    Orcamento[]
  vendas        Venda[]
  notificacoes  Notificacao[]
  pastasArquivo PastaArquivo[]
  followUpsAgendados FollowUpAgendado[]

  @@unique([empresaId, telefone])
  @@map("leads")
}

// Grupo de clientes (ex: "VIP", "Inadimplente", "Plano anual") — só pra
// organização/marcação visual na tela de Clientes, um lead pertence a no
// máximo um grupo por vez.
model GrupoCliente {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  cor       String   @default("#6B7280")
  criadoEm  DateTime @default(now()) @map("criado_em")

  leads Lead[]

  @@map("grupos_cliente")
}

model HistoricoEtapa {
  id              String     @id @default(uuid())
  leadId          String     @map("lead_id")
  lead            Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  etapaId         String     @map("etapa_id")
  etapa           EtapaFunil @relation(fields: [etapaId], references: [id])
  entrouEm        DateTime   @default(now()) @map("entrou_em")
  saiuEm          DateTime?  @map("saiu_em")
  motivoTransicao String     @default("decisao_ia") @map("motivo_transicao")
  vendedorId      String?    @map("vendedor_id")
  vendedor        Usuario?   @relation("VendedorHistorico", fields: [vendedorId], references: [id])

  @@map("historico_etapas")
}

model Mensagem {
  id            String            @id @default(uuid())
  leadId        String            @map("lead_id")
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  remetente     RemetenteMensagem
  conteudo      String
  enviadoEm     DateTime          @default(now()) @map("enviado_em")
  statusEntrega StatusEntrega     @default(enviado) @map("status_entrega")
  vendedorId    String?           @map("vendedor_id")
  vendedor      Usuario?          @relation(fields: [vendedorId], references: [id])

  @@map("mensagens")
}

model Reuniao {
  id             String           @id @default(uuid())
  leadId         String           @map("lead_id")
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendedorId     String?          @map("vendedor_id")
  vendedor       Usuario?         @relation("VendedorReunioes", fields: [vendedorId], references: [id])
  dataHora       DateTime         @map("data_hora")
  status         StatusReuniao    @default(agendada)
  resultado      ResultadoReuniao @default(pendente)
  linkCalendario String?          @map("link_calendario")
  googleEventId  String?          @map("google_event_id")
  modalidade     ModalidadeReuniao @default(whatsapp)
  titulo         String?          @db.Text
  // Descrição do evento no Google Calendar — se nula, usa o texto padrão
  // (ver eventoBody em googleCalendar.ts). Preenchida automaticamente a
  // partir dos dados de contrato do cliente (Lead/Venda) quando a reunião
  // é criada como "follow-up de renovação" (ver reuniaoDescricao.ts).
  descricao      String?          @db.Text
  // E-mails extras convidados pra reunião (além do e-mail do lead), pedidos
  // explicitamente ao agendar (manual, IA do funil ou Assistente) —
  // persistido pra sincronizarReuniaoComGoogle incluir como "attendees" do
  // evento do Google (convite nativo, com botão de entrar no Meet) mesmo
  // numa resincronização posterior, não só na criação.
  emailsConvidados String[]        @default([]) @map("emails_convidados")
  // Endereço do encontro — só usado/exibido quando modalidade = presencial.
  endereco       String?          @db.Text
  lembrete1hEnviado      Boolean  @default(false) @map("lembrete_1h_enviado")
  lembrete15minEnviado   Boolean  @default(false) @map("lembrete_15min_enviado")
  lembreteInicioEnviado  Boolean  @default(false) @map("lembrete_inicio_enviado")
  criadoEm       DateTime         @default(now()) @map("criado_em")

  notificacoes Notificacao[]

  @@map("reunioes")
}

model AgenteIa {
  id        String     @id @default(uuid())
  empresaId String     @map("empresa_id")
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  persona   String
  objetivo  String
  etapaId   String     @map("etapa_id")
  etapa     EtapaFunil @relation(fields: [etapaId], references: [id])
  modeloLlm String     @default("gemini-3.6-flash") @map("modelo_llm")
  ativo     Boolean    @default(true)

  @@map("agentes_ia")
}

model Configuracao {
  id        String  @id @default(uuid())
  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chave     String
  valor     String

  @@unique([empresaId, chave])
  @@map("configuracoes")
}

model WhatsappSessao {
  id              String                @id @default(uuid())
  empresaId       String                @unique @map("empresa_id")
  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  status          StatusWhatsappSessao  @default(desconectado)
  numeroConectado String?               @map("numero_conectado")
  atualizadoEm    DateTime              @updatedAt @map("atualizado_em")

  @@map("whatsapp_sessoes")
}

model Plano {
  id            String             @id @default(uuid())
  empresaId     String             @map("empresa_id")
  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  valor         Decimal            @db.Decimal(12, 2)
  periodicidade PeriodicidadePlano @default(mensal)
  ativo         Boolean            @default(true)
  criadoEm      DateTime           @default(now()) @map("criado_em")

  orcamentos Orcamento[]

  @@map("planos")
}

model Orcamento {
  id          String          @id @default(uuid())
  empresaId   String          @map("empresa_id")
  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  leadId      String          @map("lead_id")
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  planoId     String?         @map("plano_id")
  plano       Plano?          @relation(fields: [planoId], references: [id])
  valor       Decimal         @db.Decimal(12, 2)
  observacoes String?
  status      StatusOrcamento @default(rascunho)
  criadoPorId String?         @map("criado_por_id")
  criadoPor   Usuario?        @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime        @default(now()) @map("criado_em")

  @@map("orcamentos")
}

model Venda {
  id                 String         @id @default(uuid())
  empresaId          String         @map("empresa_id")
  empresa            Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  leadId             String?        @map("lead_id")
  lead               Lead?          @relation(fields: [leadId], references: [id])
  vendedorId         String?        @map("vendedor_id")
  vendedor           Usuario?       @relation(fields: [vendedorId], references: [id])
  valor              Decimal        @db.Decimal(12, 2)
  quantidade         Int            @default(1)
  formaPagamento     FormaPagamento @map("forma_pagamento")
  recorrente         Boolean        @default(false)
  proximaCobrancaEm  DateTime?      @map("proxima_cobranca_em")
  comissaoIntegral   Boolean        @default(true) @map("comissao_integral")
  comissaoPercentual Decimal?       @db.Decimal(5, 2) @map("comissao_percentual")
  dataPagamento      DateTime       @default(now()) @map("data_pagamento")
  status             StatusVenda    @default(confirmada)
  comprovantePath    String?        @map("comprovante_path")
  // Datas de vigência do contrato — usadas pra montar automaticamente a
  // descrição do evento de reunião de follow-up/renovação (ver
  // src/lib/reuniaoDescricao.ts). Opcionais: vendas avulsas sem contrato
  // formal não precisam preencher.
  contratoInicioEm    DateTime?     @map("contrato_inicio_em")
  contratoFimEm       DateTime?     @map("contrato_fim_em")
  statusContratoTexto String?       @map("status_contrato_texto")
  criadoEm           DateTime       @default(now()) @map("criado_em")

  @@map("vendas")
}

// Chat "Assistente" (apoio ao vendedor, distinto da conversa com o lead) —
// escopado por usuário+empresa, já que o contexto do assistente muda por
// empresa (empresa_sobre) e cada conta agora pode ter várias. Mensagens
// somem depois de 30 dias (ver pollLimparAssistente em
// src/lib/assistenteHistorico.ts).
model AssistenteMensagem {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId String   @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  autor     String
  conteudo  String
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("assistente_mensagens")
}

// Follow-up manual agendado pontualmente a partir da conversa de um lead
// (presets "em 1h/3h/amanhã" ou data customizada) — diferente do follow-up
// periódico automático (followUpService.ts::pollFollowUpClientes, que roda
// por intervalo configurado pra todo cliente). Processado por
// pollFollowUpsAgendados (mesmo mecanismo de cron/tick).
model FollowUpAgendado {
  id        String                  @id @default(uuid())
  empresaId String                  @map("empresa_id")
  empresa   Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  leadId    String                  @map("lead_id")
  lead      Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enviarEm  DateTime                @map("enviar_em")
  enviadoEm DateTime?               @map("enviado_em")
  status    StatusFollowUpAgendado  @default(pendente)
  // Se preenchido, enviado ao pé da letra; se vazio, a IA escreve a mensagem
  // de reengajamento na hora do envio (mesmo padrão de resolverTextoConfiguravel).
  textoPersonalizado String?        @db.Text @map("texto_personalizado")
  criadoPorId String?               @map("criado_por_id")
  criadoPor   Usuario?              @relation(fields: [criadoPorId], references: [id])
  erro        String?               @db.Text
  criadoEm    DateTime              @default(now()) @map("criado_em")

  @@map("follow_ups_agendados")
}

model Notificacao {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo      String
  titulo    String
  corpo     String
  leadId    String?  @map("lead_id")
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  reuniaoId String?  @map("reuniao_id")
  reuniao   Reuniao? @relation(fields: [reuniaoId], references: [id], onDelete: SetNull)
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("notificacoes")
}

model PastaArquivo {
  id        String    @id @default(uuid())
  empresaId String    @map("empresa_id")
  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  // Pasta "do cliente" criada automaticamente na tela do Lead — no máximo
  // uma por lead (ver GET /api/leads/[id]/arquivos, find-or-create). Pastas
  // manuais (tela Arquivos) têm leadId nulo, sem mudança de comportamento.
  leadId    String?   @unique @map("lead_id")
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  criadoEm  DateTime  @default(now()) @map("criado_em")

  arquivos Arquivo[]

  @@map("pastas_arquivo")
}

model Arquivo {
  id           String       @id @default(uuid())
  empresaId    String       @map("empresa_id")
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pastaId      String       @map("pasta_id")
  pasta        PastaArquivo @relation(fields: [pastaId], references: [id], onDelete: Cascade)
  nome         String
  storagePath  String       @map("storage_path")
  tamanhoBytes Int          @map("tamanho_bytes")
  mimeType     String       @map("mime_type")
  criadoPorId  String?      @map("criado_por_id")
  criadoEm     DateTime     @default(now()) @map("criado_em")

  @@map("arquivos")
}
